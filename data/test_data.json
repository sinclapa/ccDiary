      "date": "1918-05-21T14:00:00Z",
      "location": "Southampton, UK",
      "entry": "I arrived at Southampton at 3 PM and left Southampton at 8 PM on board the Antrim for France.",
      "mapLocation": "Southampton, UK",
      "showMap": true,
      "fromLocation": null,
      "toLocation": null,
