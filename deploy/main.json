              "type": "string",
              "value": "[reference('staticSite').defaultHostname]"
            },
            "resourceGroupId": {
              "type": "string",
              "value": "[resourceGroup().id]"
            },
            "resourceGroupName": {
              "type": "string",
              "value": "[resourceGroup().name]"
            },
            "appName": {
              "type": "string",
              "value": "[variables('appName')]"
            }
          }
        }
      },
      "dependsOn": [
        "resourceGroup"
      ]
    }
  },
  "outputs": {
    "environment": {
      "type": "object",
      "value": "[reference('resourceGroupModule').outputs]"
    }
  }
}