<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ccDiary.Migrate</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- A one-shot operator tool: no XML docs, and Console.WriteLine is the interface. -->
    <NoWarn>$(NoWarn),1591,CA1303,CA1848,CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ccDiaryApiTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the old database directly rather than through EF, so this tool keeps
         working after the EF packages and migrations are deleted from the API. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Writes through the API's own services and key derivations. Reimplementing them
         here would let the tool and the application drift apart silently, which is the
         one failure this tool exists to rule out. -->
    <ProjectReference Include="..\ccDiaryApi\ccDiaryApi.csproj" />
  </ItemGroup>

</Project>
