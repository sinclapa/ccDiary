# .dockerignore for ccDiary API - Build from artifacts

# Git
.git
.gitignore
.github/

# Documentation
README.md
*.md

# Source code and solution files (required by compose build)
launchSettings.json

# Build outputs (except publish directory)
**/bin
**/obj
**/out

# Keep publish directory
!publish/

# Test results
**/TestResults/
**/*.trx
**/coverage/

# Visual Studio / IDE
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
**/.project
**/.settings
**/.toolstarget

# Docker compose files
**/docker-compose*

# Environment files
**/.env
.env*

# Node modules
**/node_modules
**/npm-debug.log

# Charts and Kubernetes
**/charts
**/azds.yaml
**/secrets.dev.yaml
**/values.dev.yaml

# Other Docker files
**/Dockerfile*
**/.dockerignore
!Dockerfile